{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3169"
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [
      "resources/wallpapers/*",
      "resources/cursors/*",
      "resources/textures/*",
      "resources/audio/*",
      "resources/UxYW2KY_x2.png"
    ]
  },
  "productName": "Quartz",
  "version": "4.0.0",
  "identifier": "com.github.ritoshark.quartz",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RitoShark/Quartz/releases/latest/download/latest.json",
        "https://github.com/FrogCsLoL/Quartz/releases/latest/download/latest.json",
        "https://github.com/DexalGT/Quartz/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RDYxQzFBNjI2ODYwM0IKUldRN1lHaGlHaHpXMTNGU1lnWVBTN3VBYjFaRmZNSzN1UzFtS3NKMmh6V20xNzkrOFJmZ2xaVDYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quartz",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' blob: 'unsafe-eval'",
        "img-src": "'self' data: https: blob: asset: https://asset.localhost",
        "connect-src": "'self' http://ipc.localhost https://github.com https://api.github.com asset: https://asset.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: asset: https://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**/*"] }
      }
    }
  }
}
