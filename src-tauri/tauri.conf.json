{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3169"
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/wallpapers/*",
      "resources/cursors/*",
      "resources/textures/*",
      "resources/audio/*",
      "resources/bin/*"
    ]
  },
  "productName": "Quartz",
  "version": "4.2.8",
  "identifier": "com.github.ritoshark.quartz",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RitoShark/Quartz/releases/latest/download/latest.json",
        "https://github.com/FrogCsLoL/Quartz/releases/latest/download/latest.json",
        "https://github.com/DexalGT/Quartz/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNTBCQkMxM0E3Mjg1ODEKUldTQmhYSTZ3YnRRVWN3OUZSWUNZLytLTUVTUjdTSEdIQzA1Y2FLT0NuZUJDVHE4Zi92eGpHc0sK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quartz",
        "width": 1280,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "updater",
        "url": "/updater.html",
        "title": "Quartz Startup",
        "width": 500,
        "height": 400,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' blob: 'unsafe-eval'",
        "img-src": "'self' data: https: blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' http://ipc.localhost https://github.com https://api.github.com https://raw.githubusercontent.com https://ddragon.leagueoflegends.com https://raw.communitydragon.org asset: http://asset.localhost https://asset.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: asset: http://asset.localhost https://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ]
        }
      }
    }
  }
}
